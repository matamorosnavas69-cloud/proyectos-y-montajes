# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Ensure brand and logo assets are tracked
!public/
public/*
!public/brand/
!public/images/
!public/favicon.ico
!public/apple-touch-icon.png
!public/icon-192.png
!public/icon-512.png
public/images/*
!public/images/logo/
!public/images/og-image.jpg
!public/images/before-after/
!public/images/before-after/**

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.turbo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Heavy raw video files (exceeds Vercel Hobby 1GB deployment limit, stream via Supabase/CDN)
*.mp4
*.mov
*.MP4
*.MOV

# backups and scratch
*.bak
qa-previews/
public/brand/qa-previews/
